# TfL Unified API — optional but raises rate limits
# Register free at https://api-portal.tfl.gov.uk/
TFL_APP_KEY=

# National Highways Road & Lane Closures v2.0 API — required for NH data
# Register free at https://developer.data.nationalhighways.co.uk/
NH_API_KEY=

# NOTE: one.network has no collector (no feed spec), so there is deliberately
# no ONE_NETWORK_API_KEY here. Re-add it together with a collector if a feed
# is ever specified.

# Database URL — SQLite for local dev, PostGIS URL for production
# SQLite:  sqlite:///./incidents.db
# PostGIS: postgresql+psycopg2://user:pass@host/dbname
DATABASE_URL=sqlite:///./incidents.db

# Polling intervals in seconds (defaults shown)
POLL_INTERVAL_NATIONAL_HIGHWAYS=120
POLL_INTERVAL_TFL=300
POLL_INTERVAL_TRAFFIC_SCOTLAND=120
POLL_INTERVAL_TRAFFIC_WATCH_NI=300

# Only incidents reported within this window are exported/uploaded per run.
EXPORT_LOOKBACK_HOURS=6

# Hourly ASC rainfall grid (NFS). Overridden per host via env, not code.
RAINFALL_DIR=/nfs/develop_pff/processing/UK/national/Rainfall/Hourly

# Empty = log to stdout. Prefer an NFS path, never /tmp or the root disk.
LOG_PATH=
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3
